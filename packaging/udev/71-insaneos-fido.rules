# InsaneOS: FIDO2 security keys for the session user (docs/PASSWORDS.md).
# insane-sessiond sessions are not logind seat sessions, so TAG+="uaccess" alone does not reach them.
# ID_FIDO_TOKEN comes from systemd's 60-fido-id.rules. Only insane-server opens the device (after the
# app's `usb` permission) and hands the fd to the sandboxed insane-vault.
ACTION=="remove", GOTO="insaneos_fido_end"
SUBSYSTEM=="hidraw", ENV{ID_FIDO_TOKEN}=="1", GROUP="plugdev", MODE="0660"
LABEL="insaneos_fido_end"
