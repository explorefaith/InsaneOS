[Unit]
Description=InsaneOS health check (boot assessment)
Documentation=https://github.com/insaneos/InsaneOS/blob/main/docs/IMMUTABLE.md
# boot-complete.target gates systemd-bless-boot.service, which marks the boot entry good
After=multi-user.target
Before=boot-complete.target
OnFailure=insaneos-health-failed.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/lib/insaneos/immutable/health-check
