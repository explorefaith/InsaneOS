[Unit]
Description=InsaneOS: per-app network permissions (insane-netperm)
After=systemd-resolved.service
Before=insaneos.service

[Service]
Type=simple
ExecStart=/usr/lib/insaneos/bin/insane-netperm
Restart=always
RestartSec=1
StandardOutput=journal
StandardError=journal
RuntimeDirectory=insaneos
RuntimeDirectoryPreserve=yes
CapabilityBoundingSet=CAP_BPF CAP_NET_ADMIN CAP_PERFMON CAP_DAC_READ_SEARCH CAP_NET_RAW
NoNewPrivileges=yes
RestrictAddressFamilies=AF_UNIX AF_PACKET AF_NETLINK
ProtectSystem=strict
ProtectHome=read-only
ProtectControlGroups=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectClock=yes
ProtectHostname=yes
PrivateTmp=yes
PrivateDevices=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
