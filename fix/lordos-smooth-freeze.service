[Unit]
Description=LordOS smooth freeze (pressure-based background app freezer)
Documentation=https://github.com/lordbasex/LordOS

[Service]
Type=simple
ExecStart=%h/.local/bin/lordos-smooth-freeze.sh
ExecStopPost=%h/.local/bin/lordos-smooth-freeze.sh thaw
Restart=on-failure
RestartSec=5
# never freeze the freezer's own group by accident
OOMScoreAdjust=-500

[Install]
WantedBy=default.target
